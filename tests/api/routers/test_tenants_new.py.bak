        id=tenant_id,
        name="Specific Tenant",
        slug="specific-tenant",
        contact_email="contact@specific.com",
        application_fee_percent=Decimal("0.030")  # 3.0%
    )
    db_session.add(tenant)
    await db_session.commit()

    # Mock JWT service to return a valid user
