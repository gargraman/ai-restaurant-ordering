    {
      "id": "t-legend-body", "type": "text",
      "x": 1000, "y": 1080, "width": 310, "height": 175,
      "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "seed": 1042, "version": 1,
      "versionNonce": 1042, "isDeleted": false, "groupIds": [], "frameId": null,
      "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false,
      "text": "Purple  = LangGraph Pipeline Nodes\nOrange  = Decision / Router\nRed     = Parallel Orchestrator\nYellow  = RRF Fusion\nPink    = AI/LLM (RAG Generator)\nGreen   = Databases (vector/graph)\nAmber   = BM25 Search (OpenSearch)\nOrange  = Cache (Redis)\nRed ext = External AI API\n\n-- dashed = session/async link", "fontSize": 12, "fontFamily": 2,
      "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "Purple  = LangGraph Pipeline Nodes\nOrange  = Decision / Router\nRed     = Parallel Orchestrator\nYellow  = RRF Fusion\nPink    = AI/LLM (RAG Generator)\nGreen   = Databases (vector/graph)\nAmber   = BM25 Search (OpenSearch)\nOrange  = Cache (Redis)\nRed ext = External AI API\n\n-- dashed = session/async link", "lineHeight": 1.25
    },

