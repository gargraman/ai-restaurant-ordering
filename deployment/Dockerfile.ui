# UI Service Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

# Copy UI package files first (for better caching)
COPY ui/package*.json ./

# Install dependencies
RUN npm install

# Copy UI source files (excluding node_modules via .dockerignore)
COPY ui/ .

# Build the Next.js app
RUN npm run build

# Create public directory if it doesn't exist
RUN mkdir -p public

# Production stage - Using Next.js standalone mode
FROM node:18-alpine

WORKDIR /app

# Copy built Next.js app from builder
COPY --from=builder /app/.next/standalone ./
# Copy public directory
COPY --from=builder /app/public ./public

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start the Next.js server
CMD ["node", "server.js"]