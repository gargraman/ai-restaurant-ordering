# Application
APP_NAME=hybrid-search-v2
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM Provider (openai or deepseek)
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=catering_menus
OPENSEARCH_USE_SSL=false

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hybrid_search

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL_SECONDS=86400

# Search Configuration
BM25_TOP_K=50
VECTOR_TOP_K=50
RRF_K=60
BM25_WEIGHT=1.0
VECTOR_WEIGHT=1.0
MAX_CONTEXT_ITEMS=8
MAX_CONTEXT_TOKENS=4000
MAX_PER_RESTAURANT=3

# API
API_HOST=0.0.0.0
API_PORT=8000

# Authentication / JWT
JWT_SECRET_KEY=your-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2024-12-18.acacia

# Payment Configuration
PLATFORM_FEE_PERCENTAGE=2.5
PLATFORM_FEE_FIXED_CENTS=30
STRIPE_PROCESSING_FEE_PERCENTAGE=2.9
STRIPE_PROCESSING_FEE_FIXED_CENTS=30

# SendGrid Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Order Platform
SENDGRID_FROM_PHONE=

# SMTP Email (fallback/legacy)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
